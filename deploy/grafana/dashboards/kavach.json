{
 "uid": "kavach-overview",
 "title": "KAVACH: agent action firewall",
 "tags": [
  "kavach",
  "security"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Decisions",
   "description": "Every tool call KAVACH decided.",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum(kavach_decisions_total)",
     "instant": true,
     "legendFormat": "Decisions"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2a78d6",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Blocked",
   "description": "DENY: a deterministic rule refused the action.",
