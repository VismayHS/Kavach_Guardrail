   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sort_desc(sum by (rule) (kavach_rule_hits_total) > 0)",
     "legendFormat": "{{rule}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2a78d6",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Decisions by tool and verdict",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum by (tool, verdict) (kavach_decisions_total)",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "tool": 0,
       "verdict": 1,
       "Value": 2
      },
      "renameByName": {
       "Value": "decisions"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "decisions",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
