  {
   "id": 31,
   "type": "stat",
   "title": "KAVACH overhead, % of agent cost",
   "description": "KAVACH's own model cost as a share of what the agents spent. Empty until an agent has reported a cost.",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 16,
    "y": 53,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "100 * (sum(kavach_model_cost_usd_total{side=\"kavach\"}) or vector(0)) / (((sum({__name__=~\"claude_code_cost_usage.*\"}) or vector(0)) + ((sum({__name__=~\"kavach_agent_cost.*\"}) or vector(0)) + (sum(kavach_model_cost_usd_total{side=\"agent\"}) or vector(0)))) > 0)",
     "instant": true,
     "legendFormat": "KAVACH overhead, % of agent cost"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "decimals": 3,
     "noValue": "no agent cost yet",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2a78d6",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "auto",
    "orientation": "auto"
   }
  },
  {
   "id": 32,
   "type": "stat",
   "title": "Failed model calls (may be billed)",
   "description": "KAVACH's model calls that errored or timed out. No tokens came back, so no cost is counted, but a call that timed out may still have been billed. The judge and explainer fall back to deterministic text; decisions never loosen.",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 20,
    "y": 53,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum(kavach_model_calls_total{outcome=\"error\"}) or vector(0)",
     "instant": true,
     "legendFormat": "Failed model calls (may be billed)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
