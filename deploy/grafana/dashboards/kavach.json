   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum(kavach_decisions_total{verdict=\"DENY\"}) or vector(0)",
     "instant": true,
     "legendFormat": "Blocked"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#d03b3b",
