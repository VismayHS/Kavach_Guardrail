   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 8,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "drawStyle": "line",
      "axisSoftMin": 0,
      "gradientMode": "none"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   }
