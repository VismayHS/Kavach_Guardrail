  {
   "id": 7,
   "type": "timeseries",
   "title": "Decisions per minute, by verdict",
   "description": "Status colours: green allow, yellow allow with a safeguard, orange to a person, red blocked. Names are in the legend.",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum by (verdict) (rate(kavach_decisions_total[1m])) * 60",
     "legendFormat": "{{verdict}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 8,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "drawStyle": "line",
      "axisSoftMin": 0,
      "gradientMode": "none"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ALLOW"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#0ca30c"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ALLOW_WITH_SAFEGUARD"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#fab219"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "ESCALATE"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ec835a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "DENY"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d03b3b"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Decision latency (ms)",
   "description": "Time to decide one tool call (rules, staging, risk; the judge when inline).",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(kavach_check_latency_ms_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(kavach_check_latency_ms_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(kavach_check_latency_ms_bucket[5m])))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 8,
      "showPoints": "never",
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "drawStyle": "line",
      "axisSoftMin": 0,
      "gradientMode": "none"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    }
   }
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Rules that fired (deny or approval)",
   "description": "Which rules are doing the work. R28 = canary tripped (a breach in progress).",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sort_desc(sum by (rule) (kavach_rule_hits_total))",
     "legendFormat": "{{rule}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#2a78d6",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Decisions by tool and verdict",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "kavach-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "kavach-prom"
     },
     "expr": "sum by (tool, verdict) (kavach_decisions_total)",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "tool": 0,
       "verdict": 1,
       "Value": 2
      },
      "renameByName": {
       "Value": "decisions"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "decisions",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
