# Copy this file to .env, add your own Qualcomm Inference Cloud API key,
# then start the server with: --env-file .env
IMAGINE_API_KEY=replace-with-your-own-key
IMAGINE_API_ENDPOINT=https://aisuite.cirrascale.com/apis/v2

# Optional: model used by the live, tool-using agent.
KAVACH_AGENT_MODEL=Llama-3.3-70B
